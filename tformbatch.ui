        <item>
         <widget class="QCheckBox" name="checkBox_5">
          <property name="styleSheet">
           <string notr="true">/* ================= 基础文本样式 ================= */
QCheckBox {
    spacing: 8px; /* 复选框与文本之间的间距 */
    
    /* 【修改点 1】颜色调整为 #333333，比纯黑更柔和，减轻视觉疲劳 */
    color: #333333; 
    
    /* 【修改点 2】字体大小从 13px 增大到 15px (或 10.5pt)，视觉更清晰 */
    font-size: 15px; 
    
    /* 【修改点 3】增加字重，让文字看起来更精神，符合现代 UI 规范 */
    font-weight: 500; 
    
    /* 【修改点 4】加入 &quot;Microsoft YaHei&quot; (微软雅黑)，防止 Windows 下回退到较小的默认字体 */
    font-family: -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, &quot;Microsoft YaHei&quot;, &quot;PingFang SC&quot;, &quot;Helvetica Neue&quot;, Arial, sans-serif;
}

/* 禁用状态下的文本颜色 (调整为更浅的灰色) */
