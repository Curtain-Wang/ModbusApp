      <string notr="true">QPushButton {
    background-color: #66BB6A; /* 更淡的绿色 */
    border: 2px solid #43A047;
    color: white;
    font-size: 22px;
    padding: 10px;
    border-radius: 10px;
    width: 100px;
    height: 50px;
    text-align: center;
}
QPushButton:hover {
    background-color: #5AAE5E;
    border: 2px solid #388E3C;
}
QPushButton:pressed {
    background-color: #4CAF50;
    border: 2px solid #2C6E2E;
}
QPushButton:checked {
    background-color: #4CAF50; /* 不再用过深绿色 */
    border: 2px solid #2E7D32;
    color: #E8F5E9;
    box-shadow: 0 0 8px rgba(76, 175, 80, 0.6);
    font-weight: bold;
}</string>
