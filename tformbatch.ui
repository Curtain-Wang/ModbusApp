    color: #999999;
}

/* ================= 指示器（方框）基础样式 ================= */
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px; 
}

/* ================= 未选中状态 ================= */
QCheckBox::indicator:unchecked {
    border: 1.5px solid #98989D; 
    background-color: #FFFFFF;
}

/* 未选中 - 鼠标悬停 */
QCheckBox::indicator:unchecked:hover {
    border: 1.5px solid #7C7C80; 
}

/* ================= 选中状态 ================= */
QCheckBox::indicator:checked {
    background-color: #0A84FF; 
    border: 1.5px solid #0A84FF;
    image: url(&quot;data:image/svg+xml;utf8,&lt;svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 16 16'&gt;&lt;path d='M3.5 8.5 L6.5 11.5 L12.5 4.5' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/&gt;&lt;/svg&gt;&quot;);
}

/* 选中 - 鼠标悬停 */
QCheckBox::indicator:checked:hover {
    background-color: #0071EB; 
    border: 1.5px solid #0071EB;
}

/* 按下状态 */
QCheckBox::indicator:pressed {
    background-color: #005BB5;
    border: 1.5px solid #005BB5;
}

/* ================= 禁用状态 ================= */
QCheckBox::indicator:unchecked:disabled {
    background-color: #F2F2F7;
    border: 1.5px solid #D1D1D6;
}

QCheckBox::indicator:checked:disabled {
    background-color: #A1A1A6; 
    border: 1.5px solid #A1A1A6;
}</string>
          </property>
