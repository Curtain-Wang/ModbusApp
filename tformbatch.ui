<ui version="4.0">
 <class>TFormBatch</class>
 <widget class="QWidget" name="TFormBatch">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>670</width>
    <height>552</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Form</string>
  </property>
  <layout class="QGridLayout" name="gridLayout">
   <item row="0" column="0">
    <widget class="QGroupBox" name="groupBox">
     <property name="title">
      <string>请选择要同步配置的模块地址</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayout">
      <item>
       <widget class="QCheckBox" name="checkBox_9">
        <property name="styleSheet">
         <string notr="true">/* ================= 基础文本样式 ================= */
QCheckBox {
    spacing: 8px; /* 复选框与文本之间的间距 */
    
    /* 【修改点 1】颜色调整为 #333333，比纯黑更柔和，减轻视觉疲劳 */
    color: #333333; 
    
    /* 【修改点 2】字体大小从 13px 增大到 15px (或 10.5pt)，视觉更清晰 */
    font-size: 15px; 
    
    /* 【修改点 3】增加字重，让文字看起来更精神，符合现代 UI 规范 */
    font-weight: 500; 
    
    /* 【修改点 4】加入 &quot;Microsoft YaHei&quot; (微软雅黑)，防止 Windows 下回退到较小的默认字体 */
    font-family: -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, &quot;Microsoft YaHei&quot;, &quot;PingFang SC&quot;, &quot;Helvetica Neue&quot;, Arial, sans-serif;
}

/* 禁用状态下的文本颜色 (调整为更浅的灰色) */
QCheckBox:disabled {
    color: #999999;
}

/* ================= 指示器（方框）基础样式 ================= */
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px; 
}

/* ================= 未选中状态 ================= */
QCheckBox::indicator:unchecked {
    border: 1.5px solid #98989D; 
    background-color: #FFFFFF;
}

/* 未选中 - 鼠标悬停 */
QCheckBox::indicator:unchecked:hover {
    border: 1.5px solid #7C7C80; 
}

/* ================= 选中状态 ================= */
QCheckBox::indicator:checked {
    background-color: #0A84FF; 
    border: 1.5px solid #0A84FF;
    image: url(&quot;data:image/svg+xml;utf8,&lt;svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 16 16'&gt;&lt;path d='M3.5 8.5 L6.5 11.5 L12.5 4.5' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/&gt;&lt;/svg&gt;&quot;);
}

/* 选中 - 鼠标悬停 */
QCheckBox::indicator:checked:hover {
    background-color: #0071EB; 
    border: 1.5px solid #0071EB;
}

/* 按下状态 */
QCheckBox::indicator:pressed {
    background-color: #005BB5;
    border: 1.5px solid #005BB5;
}

/* ================= 禁用状态 ================= */
QCheckBox::indicator:unchecked:disabled {
    background-color: #F2F2F7;
    border: 1.5px solid #D1D1D6;
}

QCheckBox::indicator:checked:disabled {
    background-color: #A1A1A6; 
    border: 1.5px solid #A1A1A6;
}</string>
        </property>
        <property name="text">
         <string>全选</string>
        </property>
       </widget>
      </item>
      <item>
