              <string notr="true">QLineEdit {
    /* 苹果风格的数据展示LineEdit */
    border: 1px solid #D0D0D0;                  /* 浅灰色边框，模仿macOS的细边框 */
    border-radius: 6px;                         /* 圆角，符合macOS设计 */
    padding: 8px 12px;                         /* 内边距，提供舒适的阅读空间 */
    background-color: #FFFFFF;                 /* 白色背景 */
    color: #333333;                            /* 深灰色文字，提高可读性 */
    font-family: &quot;SF Pro Text&quot;, &quot;Helvetica Neue&quot;, &quot;Lucida Grande&quot;, sans-serif; /* macOS系统字体栈 */
    font-size: 14px;                           /* 默认字体大小 */
    selection-background-color: #007AFF;       /* 选中文本高亮色 (macOS蓝色) */
    selection-color: #FFFFFF;                  /* 选中文本颜色 (白色) */

    /* 只读状态下的特殊样式 */
    /* 注意：Qt中通常使用 setReadOnly(true) 来实现只读，但QSS可以定义其外观 */
}

/* 当LineEdit获得焦点时 (对于数据展示框，如果不需要焦点效果，可以省略或弱化) */
QLineEdit:focus {
    border: 1px solid #007AFF;                 /* 获得焦点时边框变为蓝色 */
    /* 如果作为纯展示框，也可以移除焦点边框变化 */
    /* border: 1px solid #D0D0D0; */
}

/* 禁用状态下的样式 (如果用于展示不可变数据) */
QLineEdit:disabled {
    background-color: #F5F5F7;                 /* macOS禁用元素背景色 */
    color: #A0A0A0;                            /* 禁用文字颜色 */
    border: 1px solid #E0E0E0;                 /* 禁用边框颜色 */
}</string>
