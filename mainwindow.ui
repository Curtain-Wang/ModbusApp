        </property>
        <property name="styleSheet">
         <string notr="true">/* 告警区域 - 无告警时 */
QLabel[status=&quot;normal&quot;] {
    background-color: #E8F5E9;           /* 柔和的淡绿 */
    border: 1px solid #A5D6A7;           /* 清新的绿边 */
    color: #256029;                      /* 深墨绿色字体，更显安心 */
    padding: 10px 14px;
    border-radius: 14px;
    font-weight: normal;                 /* 无需强调，去掉 bold */
    margin: 10px 12px;
}
/* 告警区域 - 告警时 */
QLabel[status=&quot;warn&quot;] {
    background-color: #FFE5E5;
    border: 1px solid #FF4D4F;
    color: #D8000C;
    padding: 10px 14px;
    border-radius: 14px;
    font-weight: bold;
    margin: 10px 12px;
}
/* 告警区域 - 未连接（无数据） */
QLabel[status=&quot;disconnected&quot;] {
    background-color: #F2F2F7;           /* Apple 系统背景灰 */
    border: 1px solid #D1D1D6;           /* Apple 系统分隔线灰 */
    color: #8E8E93;                      /* Apple 系统文本辅助灰 */
    padding: 10px 14px;
    border-radius: 14px;
    font-weight: normal;
    font-style: italic;                  /* 可选，让状态感更明确 */
    margin: 10px 12px;
}</string>
        </property>
        <property name="text">
         <string>未连接</string>
        </property>
        <property name="alignment">
